# Database — Supabase
# IMPORTANT: use the "Transaction pooler" connection string (Project Settings > Database >
# Connection string > Transaction pooler), NOT "Direct connection". The direct-connection
# host (db.<ref>.supabase.co) only publishes an IPv6 (AAAA) DNS record; if your network
# has no IPv6 route, Spring Boot will fail to start with an UnknownHostException /
# connection-refused error from Flyway/Hikari. The pooler host (aws-0-<region>.pooler.
# supabase.com) is IPv4-compatible and transaction mode avoids exhausting session slots
# while old and new application replicas overlap during a rolling deployment.
# prepareThreshold=0 disables server-side prepared statements, required for poolers that
# reuse connections (pgBouncer/Supabase) to avoid "prepared statement S_1 already exists".
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=your_supabase_password_here
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1

# Kafka notification topic and listener
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_NOTIFICATION_TOPIC=notifications
KAFKA_NOTIFICATION_PARTITIONS=1
KAFKA_NOTIFICATION_REPLICAS=1
KAFKA_NOTIFICATION_CONSUMER_GROUP=user-notification-listener
KAFKA_NOTIFICATION_CONCURRENCY=1

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=replace_with_64_byte_hex_secret
JWT_EXPIRY_MS=86400000

# Transactional email â€” Resend. Use a verified sending domain in production.
# Sender domain must be verified in Resend before production delivery is enabled.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=IBM Consulting Simulation <no-reply@mail.ibm-simulator.com>
RESEND_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
APP_PUBLIC_WEB_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=15
EMAIL_RESEND_COOLDOWN_SECONDS=60

# Machine-to-machine token protecting /actuator/prometheus in deployed environments.
# Set this as a secret on both the API and its Prometheus service in Railway.
# Generate with: openssl rand -hex 32
OBSERVABILITY_TOKEN=replace_with_observability_token

# Initial administrator account — seeded automatically on backend startup (idempotent).
# Leave blank to skip seeding. Change ADMIN_PASSWORD only takes effect on first creation;
# use the in-app admin user management API to change it afterwards.
ADMIN_EMAIL=admin@ibm-consulting-sim.local
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_DISPLAY_NAME=Platform Administrator

# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# AI Orchestration Layer — multi-provider (watsonx + free models). See
# apps/api/.../ai/application/AiProviderRouter.java and
# docs/architecture/AI_ORCHESTRATION.md for the full design.
# Leave AI_MOCK_MODE=true (default) to use the deterministic MockAiGateway with
# no external calls at all — the safe default for anyone cloning this repo.
AI_MOCK_MODE=true
AI_PARALLEL_ENABLED=true
AI_PARALLEL_MAX_CANDIDATES=3

# Gemini free tier — primary provider for live conversation + cheap classification.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# OpenRouter free tier — emergency/dev fallback only (free plan is ~50 req/day, so
# it is always last-priority in the routing table, never primary).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=openai/gpt-oss-20b:free

# Spring
SPRING_PROFILES_ACTIVE=dev

# Caching — Upstash Redis (distributed). Leave CACHE_PROVIDER=caffeine (or
# blank) to use JVM-local caching instead with no external dependency.
# Create a free database at https://console.upstash.com to get these values.
# To later swap to IBM's own Redis, see CacheConfig.java — set
# CACHE_PROVIDER=redis once that provider is implemented; no other code changes.
CACHE_PROVIDER=caffeine
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Local Grafana login (the observability Compose profile only).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_password
