auth_enabled: false

server:
  http_listen_port: ${LOKI_PORT}

common:
  path_prefix: /loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

storage_config:
  filesystem:
    directory: /loki/chunks

limits_config:
  retention_period: ${LOKI_RETENTION_PERIOD:-336h}

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem
